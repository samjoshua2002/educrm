# Cloudflare R2 Credentials (Copy this file to .env.local and fill in your values)
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=educrm
R2_ENDPOINT=https://your_account_id.r2.cloudflarestorage.com
R2_PUBLIC_URL=https://pub-your_public_domain.r2.dev
NEXT_PUBLIC_R2_PUBLIC_URL=https://pub-your_public_domain.r2.dev
